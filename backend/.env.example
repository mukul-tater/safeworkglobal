# Legacy SMS providers (unused by app UI — clients use Firebase Phone Auth).
# Still required only if something calls POST /api/workers/otp/send directly.
OTP_PROVIDER=fast2sms
FAST2SMS_API_KEY=

# MSG91 alternative
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Firebase Admin — required for POST /api/workers/otp/verify-firebase
# (Phase-1 /register exchanges Firebase ID token for otpToken)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or set FIREBASE_SERVICE_ACCOUNT_JSON='{...}'
