VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Mobile SMS OTP — Firebase Phone Auth (required for all phone OTP flows):
# worker quick-signup, worker bind-mobile, /register, emitra register/login, /lsp/verify.
# 1. Create a Firebase web app and enable Authentication → Sign-in method → Phone.
# 2. Upgrade project to Blaze (required for production SMS).
# 3. Add Authorized domains (127.0.0.1, production host). Allow India (+91) in SMS region policy.
# 4. Paste web config below. Optional: add test phone numbers in Firebase Console for QA.
#
# Worker contact email is typed on essentials / profile (profiles.email). Auth stays
# on the synthetic mobile login email — do not change auth email for phone workers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Google OAuth (local Vite):
# On localhost / 127.0.0.1 the Lovable /~oauth broker is not available.
# The app falls back to supabase.auth.signInWithOAuth.
# In Supabase → Authentication → URL Configuration, add:
#   http://127.0.0.1:8080/auth
#   http://localhost:8080/auth
# And enable the Google provider. On Lovable-hosted / production hosts,
# /~oauth/initiate is used automatically.
# Force either path with: VITE_USE_LOVABLE_OAUTH=true|false
VITE_USE_LOVABLE_OAUTH=
# Set these as Supabase Edge Function secrets on `razorpay-assessment` only:
#   RAZORPAY_KEY_ID=rzp_test_...
#   RAZORPAY_KEY_SECRET=...
# The public key_id is returned to the browser by create_order (never store the secret in Lovable frontend env).

# Independent-worker Aadhaar OTP (edge function `aadhaar-otp` secrets — never VITE_):
#   SUREPASS_BEARER_TOKEN=...
#   SUREPASS_BASE_URL=https://kyc-api.surepass.io
# Local/QA without a vendor account:
#   AADHAAR_OTP_MOCK=true   (OTP is 123456)
# Partner-onboarded workers do not use this — last 4 + in-person at the centre.
