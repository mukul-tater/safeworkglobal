VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Worker mobile SMS OTP (Firebase Phone Auth) — required for /worker/quick-signup mobile path.
# 1. Create a Firebase web app and enable Authentication → Sign-in method → Phone.
# 2. Upgrade project to Blaze (required for production SMS).
# 3. Paste web config below. Optional: add test phone numbers in Firebase Console for QA.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay Checkout (test key is fine for now). Get from https://dashboard.razorpay.com/app/keys
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
VITE_RAZORPAY_KEY_ID=
