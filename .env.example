VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Mobile SMS OTP — Firebase Phone Auth (required for all phone OTP flows):
# worker quick-signup, worker bind-mobile, /register, emitra register/login, /lsp/verify.
# 1. Create a Firebase web app and enable Authentication → Sign-in method → Phone.
# 2. Upgrade project to Blaze (required for production SMS).
# 3. Add Authorized domains (127.0.0.1, production host). Allow India (+91) in SMS region policy.
# 4. Paste web config below. Optional: add test phone numbers in Firebase Console for QA.
#
# Worker contact email is typed on essentials / profile (profiles.email). Auth stays
# on the synthetic mobile login email — do not change auth email for phone workers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay — public key for Checkout.js (safe in frontend)
# Get from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=

# Razorpay secret — NEVER put in VITE_*. Set as Supabase Edge Function secrets:
#   RAZORPAY_KEY_ID=rzp_test_...
#   RAZORPAY_KEY_SECRET=...
# Function: supabase/functions/razorpay-assessment
# Optional local-only (gitignored .env): RAZORPAY_KEY_SECRET=
